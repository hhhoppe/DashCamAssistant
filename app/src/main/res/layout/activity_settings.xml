<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCalibrationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Статус калибровки"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCalibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Начать калибровку"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnShowMask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Показать маску"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnResetCalibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сбросить калибровку"
        android:backgroundTint="#FF9800" />

</LinearLayout>